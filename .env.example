TRMNL_BASE_URL=https://trmnl.com
TRMNL_API_KEY=
# display advances the playlist; current_screen mirrors its current screen.
TRMNL_MODE=display
ZECTRIX_BASE_URL=https://cloud.zectrix.com
ZECTRIX_API_KEY=
ZECTRIX_DEVICE_ID=
ZECTRIX_PAGE_ID=1
ZECTRIX_DITHER=true
# Minimum interval in seconds; a larger TRMNL refresh_rate takes precedence.
REFRESH_INTERVAL=300
REQUEST_TIMEOUT=30
RETRY_MAX_DELAY=3600
# contain: white padding; cover: crop edges; fill: stretch.
IMAGE_FIT=contain
STATE_DIR=./data
